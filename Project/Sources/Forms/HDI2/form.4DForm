{
	"destination": "detailScreen",
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"width": 1000,
	"height": 600,
	"menuBar": "Menu Bar #1",
	"markerHeader": 15,
	"markerBody": 200,
	"markerBreak": 220,
	"markerFooter": 240,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onDoubleClick",
		"onMenuSelect",
		"onDataChange",
		"onUnload",
		"onAfterEdit",
		"onPageChange"
	],
	"method": "method.4dm",
	"pageFormat": {
		"paperName": "US Letter",
		"paperWidth": "612pt",
		"paperHeight": "792pt"
	},
	"pages": [
		{
			"objects": {
				"Tab Control": {
					"type": "tab",
					"top": 20,
					"left": 20,
					"width": 960,
					"height": 560,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "TabControl",
					"dataSourceTypeHint": "arrayText",
					"labels": [
						"Page 1",
						"Page 2"
					],
					"action": "GotoPage",
					"method": "ObjectMethods/Tab Control.4dm",
					"events": [
						"onClick"
					]
				}
			}
		},
		{
			"objects": {
				"Picture45": {
					"type": "picture",
					"top": 84,
					"left": 560,
					"width": 400,
					"height": 400,
					"pictureFormat": "scaled",
					"picture": "/RESOURCES/background.png"
				},
				"Button": {
					"type": "button",
					"top": 541,
					"left": 867,
					"width": 95,
					"height": 20,
					"text": "Demo",
					"focusable": false,
					"method": "ObjectMethods/Button.4dm",
					"events": [
						"onClick"
					]
				},
				"Text10": {
					"type": "text",
					"top": 80,
					"left": 40,
					"width": 560,
					"height": 80,
					"fontFamily": "System Font",
					"fontSize": 24,
					"text": "A new set of commands is now available to create and manage tables:"
				},
				"Text11": {
					"type": "text",
					"top": 160,
					"left": 60,
					"width": 420,
					"height": 148,
					"stroke": "#191970",
					"fontFamily": "System Font",
					"fontSize": 24,
					"text": "WP Insert table\rWP Table append row\rWP Table get columns\rWP Table get rows\rWP Table get cells\r\r"
				},
				"Text12": {
					"type": "text",
					"top": 360,
					"left": 40,
					"width": 770,
					"height": 80,
					"fontFamily": "System Font",
					"fontSize": 24,
					"text": "In order to apply styles to the table or cells, all these commands return a range that can be passed as parameter to:"
				},
				"Text13": {
					"type": "text",
					"top": 440,
					"left": 60,
					"width": 420,
					"height": 68,
					"stroke": "#191970",
					"fontFamily": "System Font",
					"fontSize": 24,
					"text": "WP SET ATTRIBUTES\rWP GET ATTRIBUTES\r"
				}
			}
		},
		{
			"objects": {
				"WParea1": {
					"type": "write",
					"top": 70,
					"left": 40,
					"width": 550,
					"height": 450,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "WParea",
					"hideFocusRing": true,
					"scrollbarVertical": "automatic",
					"scrollbarHorizontal": "automatic",
					"showSelection": true,
					"showHorizontalRuler": false,
					"showVerticalRuler": false,
					"layoutMode": "embedded",
					"events": [
						"onLoad",
						"onLosingFocus",
						"onGettingFocus",
						"onSelectionChange",
						"onAfterEdit"
					]
				},
				"Button1": {
					"type": "button",
					"top": 114,
					"left": 610,
					"width": 352,
					"height": 23,
					"text": "Create table and append rows",
					"focusable": false,
					"method": "ObjectMethods/Button1.4dm",
					"events": [
						"onClick"
					]
				},
				"Button6": {
					"type": "button",
					"top": 209,
					"left": 610,
					"width": 352,
					"height": 23,
