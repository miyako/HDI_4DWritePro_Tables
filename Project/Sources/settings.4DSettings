<?xml version="1.0" encoding="UTF-8"?><preferences stamp="52">
	<com.4d>
		<general allow_user_settings="false" startup_environnement="1"/>
		<interface>
			<user flush_window="false" print_progress="false" splash_screen="false"/>
			<shortcuts>
				<accept_input_form alt="false" command="false" ctrl="false" key_code="0" shift="false"/>
				<cancel_input_form alt="false" command="false" ctrl="false" key_code="0" shift="false"/>
				<add_subform alt="false" command="false" ctrl="false" key_code="0" shift="false"/>
			</shortcuts>
			<developper display_toolbar="true"/>          </interface>
		<database>
			<cache size_fixed="32" size_maximum="100" size_reserved="128"/>
			<misc standard_xpath="false" non_blocking_printing="false"/>
		</database>
		<web>
			<standalone_server>
				<configuration allow_ssl="false" port_number="80" publish_at_startup="true" session_mode="2" automatic_session_management="true"/>
				<misc/>
				<rest launch_at_startup="true"/>
				<options>
					<cache cache_max_size="524288" use_4d_web_cache="false"/>
					<web_processes max_concurrent="200" preemptive="true"/>
				</options>
			</standalone_server>
			<remote>
				<configuration allow_ssl="false" session_mode="2" automatic_session_management="true"/>
				<misc/>
				<options>
					<cache use_4d_web_cache="false"/>
				</options>
			</remote>
		</web>
		<compiler>
			<options symbol_file="false" compilation_path="1"/>
		</compiler>
		<server>
			<network>
				<options publication_name="HowDoI"/>
				<client_server use_encryption="false"/>
			</network>
		</server>
		<php ip_address="127.0.0.1"/>          </com.4d>  </preferences>